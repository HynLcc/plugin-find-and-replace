# Teable Find and Replace Plugin Environment Configuration

# =============================================================================
# CROSS-ORIGIN CONFIGURATION (跨域配置)
# =============================================================================
# Set this variable when the plugin is deployed on a different domain
# than your Teable instance.
#
# Example: NEXT_PUBLIC_TEABLE_HOST=https://teable.yourdomain.com
# Example: NEXT_PUBLIC_TEABLE_HOST=http://localhost:3000 (development)
#
# If this variable is NOT set, the plugin will use same-origin mode
# and automatically use the current domain for API requests.

NEXT_PUBLIC_TEABLE_HOST=

# =============================================================================
# MODES OF OPERATION (运行模式)
# =============================================================================

# 1. SAME-ORIGIN MODE (同域模式) - Default
#    - Do NOT set NEXT_PUBLIC_TEABLE_HOST
#    - Plugin uses current domain: `${window.location.origin}/api`
#    - Authentication: Browser automatically sends cookies
#    - Use case: Plugin and Teable are on the same domain

# 2. CROSS-ORIGIN MODE (跨域模式)
#    - Set NEXT_PUBLIC_TEABLE_HOST to your Teable instance URL
#    - Plugin uses: `${NEXT_PUBLIC_TEABLE_HOST}/api`
#    - Authentication: Uses bridge.getSelfTempToken() for Bearer token
#    - Use case: Plugin and Teable are on different domains

# =============================================================================
# EXAMPLES (配置示例)
# =============================================================================

# Example 1: Development with cross-origin
# Plugin runs on http://localhost:3001, Teable on http://localhost:3000
# NEXT_PUBLIC_TEABLE_HOST=http://localhost:3000

# Example 2: Production cross-origin deployment
# Plugin runs on https://plugins.yourdomain.com, Teable on https://teable.yourdomain.com
# NEXT_PUBLIC_TEABLE_HOST=https://teable.yourdomain.com

# Example 3: Same-origin deployment (default behavior)
# Plugin and Teable both run on https://teable.yourdomain.com
# No environment variable needed